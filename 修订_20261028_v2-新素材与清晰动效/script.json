            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          }
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_23",
      "text": "但这不是他的主判断，他现在押的，还是10月底到11月上旬完成这一轮筑底。",
      "subtitleHighlights": [],
      "shots": [
        {
          "source_id": "pexels_7592929",
          "path": "materials/pexels_7592929.mp4",
          "fit_to_audio": true,
          "supports": "阅读财经新闻的真实动作打底，回到托尔森主要时间窗；官方人物图与来源保留。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_frame": 3
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_24",
      "text": "白银也是类似，跌破55美元之后，托尔森认为下一步测试50美元趋势线支撑的可能性正在上升。",
      "subtitleHighlights": [
        "50美元"
      ],
      "shots": [
        {
          "source_id": "pexels_11271609",
          "path": "materials/pexels_11271609.mp4",
          "fit_to_audio": true,
          "supports": "白银戒指抛光的真实动作支持白银标的，原白银走势图与55/50价格位只作报告证据与预测。",
          "transition": "cut",
