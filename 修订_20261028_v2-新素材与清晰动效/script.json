      "shots": [
        {
          "source_id": "pexels_29188225",
          "path": "materials/pexels_29188225.mp4",
          "fit_to_audio": true,
          "supports": "华盛顿街口车辆通行实景提供美国政经语境，原TNX真实周线、5%与4.988%读数承担收益率证据；不冒充美债交易现场。",
