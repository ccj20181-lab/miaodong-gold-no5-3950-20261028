      "overlayStrength": 0.32
    },
    {
      "id": "scene_27",
      "text": "这个变化非常大，但12月加息风险还没有消失。",
      "subtitleHighlights": [],
      "shots": [
        {
          "source_id": "pexels_5909916",
          "path": "materials/pexels_5909916.mp4",
