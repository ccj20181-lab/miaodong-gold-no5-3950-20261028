            "originX": 50,
            "originY": 50
          },
          "in_seconds": 3.033333333333333,
          "duration_seconds": 8.3
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_21",
      "text": "托尔森也给了一个更极端的情况：中期选举之后，如果美股出现严重下跌，黄金可能被一起拖下去。",
      "subtitleHighlights": [],
      "shots": [
        {
          "source_id": "pexels_37558975",
          "path": "materials/pexels_37558975.mp4",
          "supports": "华尔街实景；严重股灾使权益资产缩水，投资者变现金，黄金也被售出；条件分支注明极端情景。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 6.566666666666666
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_22",
      "text": "到了这种极端情况，他才把黄金更深的位置看到3500美元附近。",
      "subtitleHighlights": [
        "3500美元"
      ],
      "shots": [
        {
          "source_id": "pexels_37558975",
          "path": "materials/pexels_37558975.mp4",
          "supports": "华尔街实景；严重股灾使权益资产缩水，投资者变现金，黄金也被售出；条件分支注明极端情景。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 6.666666666666667,
          "duration_seconds": 4.666666666666667
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_23",
      "text": "但这不是他的主判断，他现在押的，还是10月底到11月上旬完成这一轮筑底。",
      "subtitleHighlights": [],
      "shots": [
        {
          "source_id": "pexels_7579951",
          "path": "materials/pexels_7579951.mp4",
          "supports": "回到分析师真实原照与主要筑底时间窗，区分3500条件分支。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 5.366666666666666
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_24",
      "text": "白银也是类似，跌破55美元之后，托尔森认为下一步测试50美元趋势线支撑的可能性正在上升。",
      "subtitleHighlights": [
        "50美元"
      ],
      "shots": [
        {
          "source_id": "pexels_4987955",
          "path": "materials/pexels_4987955.mp4",
          "supports": "美国铸币局实景作贵金属机构资料；原白银报告图聚焦55下方与50趋势线，标明预测支撑。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 7.166666666666667
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_25",
      "text": "再看美债，10年期美债收益率上周已经收在5%下方，托尔森认为这里可能正在形成10月阶段高点。",
      "subtitleHighlights": [
        "5%"
      ],
      "shots": [
        {
          "source_id": "pexels_29188213",
          "path": "materials/pexels_29188213.mp4",
          "supports": "美国财政建筑实景；揭示原TNX周线真实过程，单位TNX除以10，最后4.988%与5%阈值分开。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 7.166666666666667
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_26",
      "text": "世界黄金协会10月26日最新周报又给了一个强信号：本周美联储再次加息的概率，已经从一个月前大约70%，降到不足10%。",
      "subtitleHighlights": [
        "70%",
        "不足10%"
      ],
      "shots": [
        {
          "source_id": "pexels_1797020",
          "path": "materials/pexels_1797020.mp4",
          "supports": "放大镜检验美元实拍；100格概率格从约70格收缩至不足10格，12月另列风险标签。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 9.566666666666666
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_27",
      "text": "这个变化非常大，但12月加息风险还没有消失。",
      "subtitleHighlights": [],
      "shots": [
        {
          "source_id": "pexels_1797020",
          "path": "materials/pexels_1797020.mp4",
          "supports": "放大镜检验美元实拍；100格概率格从约70格收缩至不足10格，12月另列风险标签。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 9.666666666666666,
          "duration_seconds": 3.466666666666667
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_28",
      "text": "所以接下来，黄金能不能完成这次“最后一洗”，就看本周美联储决议。",
      "subtitleHighlights": [
        "最后一洗",
        "美联储决议"
      ],
      "shots": [
        {
          "source_id": "pexels_4393479",
          "path": "materials/pexels_4393479.mp4",
          "supports": "美元钞票实拍和议息日历翻页，决议作为待发生催化；不冒充发布会现场。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 4.4
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_29",
      "text": "然后再看PCE通胀数据，会不会重新把加息预期推上去。",
      "subtitleHighlights": [
        "PCE通胀数据"
      ],
      "shots": [
        {
          "source_id": "pexels_5466779",
          "path": "materials/pexels_5466779.mp4",
          "supports": "真实数钞动作；通胀压力活塞上升推动加息预期标尺，表达条件机制。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 4.333333333333333
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_30",
      "text": "托尔森这套逻辑很简单：收益率先见顶，黄金再完成最后一次洗盘，然后进入新的筑底窗口。",
      "subtitleHighlights": [],
      "shots": [
        {
          "source_id": "pexels_4145888",
          "path": "materials/pexels_4145888.mp4",
          "supports": "美元资料打底；预期利息筹码减少、持金机会成本压力解除、黄金承接面稳定，最后指向筑底窗口。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 6.266666666666667
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_31",
      "text": "10月15日，他提前把回调目标看到3950美元；8天之后，黄金最低已经杀到3975美元。",
      "subtitleHighlights": [
        "3950美元",
        "3975美元",
        "50美元"
      ],
      "shots": [
        {
          "source_id": "pexels_38711950",
          "path": "materials/pexels_38711950.mp4",
          "supports": "市场热图实拍；10月15日至23日八日跨度，分别落定3950预测和3975实际低点，保留差距。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 8.2
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_32",
      "text": "10月25日，他再次强调：3950美元附近，可能就是最后一轮洗盘。",
      "subtitleHighlights": [
        "3950美元",
        "25",
        "50美元"
      ],
      "shots": [
        {
          "source_id": "pexels_30445098",
          "path": "materials/pexels_30445098.mp4",
          "supports": "双屏研究实拍；10月25日最新判断与3950再次出现，标明仍是判断。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 5.3
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_33",
      "text": "接下来的关键窗口，只剩未来一到两周。3950美元，到底会不会成为黄金的“最后一跌”？评论区打出你的判断。",
      "subtitleHighlights": [
        "3950美元",
        "最后一跌",
        "50美元",
        "未来一到两周"
      ],
      "shots": [
        {
          "source_id": "pexels_4319342",
          "path": "materials/pexels_4319342.mp4",
          "supports": "纽约证券交易所实景；未来一到两周日历与关键观察线，留时间读互动问题。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 8.666666666666666
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_34",
      "text": "我们不当韭菜，只做先知先觉的那拨人。",
      "subtitleHighlights": [],
      "shots": [
        {
          "source_id": "pexels_5651767",
          "path": "materials/pexels_5651767.mp4",
          "supports": "真实美元与硬币实拍继续运动；短语随口播出现，结尾不放封面。",
          "transition": "cut",
          "transitionFrames": 0,
          "camera": {
            "startScale": 1,
            "endScale": 1.012,
            "originX": 50,
            "originY": 50
          },
          "in_seconds": 0.1,
          "duration_seconds": 3.0
        }
      ],
      "overlayStrength": 0.32
    },
    {
      "id": "scene_35",
      "text": "我会继续跟踪黄金最新动态，有新的变化第一时间更新。我们下期见。",
      "subtitleHighlights": [],
